# /etc/systemd/system/site-sync.service — started by site-sync.timer.
# Pulls (and, where listed, deploys) every repo in /etc/site-sync/repos.list.
# See site-sync.sh for what runs as whom.
#
# Runs as root because kidnet's install.sh installs packages, units and nginx
# config. Git itself runs as each clone's owner. That means: anyone who can push
# to main of a repo with a deploy command can run code as root here, the same
# trust the old `sudo server/install.sh` by hand implied.
[Unit]
Description=Pull and deploy *.dobrowney.com sites from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/site-sync
StateDirectory=site-sync
Nice=10
